# .zshrc

# Reuse the portable environment setup for shells started without -l.
if [[ -z "${DOTFILES_COMMON_PROFILE_LOADED:-}" ]]; then
    source "$HOME/.profile"
    export DOTFILES_COMMON_PROFILE_LOADED=1
fi

# Use the custom prompt and terminal title.
source "$HOME/.zsh_prompt"

# Keep a large, timestamped history file and append each command immediately.
# SHARE_HISTORY is intentionally disabled so commands from other sessions appear
# only after starting a new shell, matching the selected cross-session mode.
export HISTFILE="${HOME}/.zsh_history.${USER}"
export HISTSIZE=100000
export SAVEHIST=$((HISTSIZE * 2))
setopt INC_APPEND_HISTORY
unsetopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS

# Prevent accidental file overwriting when redirecting output.
setopt NO_CLOBBER

# Disable terminal beeps.
setopt NO_BEEP

# Ignore the same low-value commands omitted by Bash's HISTIGNORE. Also omit
# invalid Git subcommands before they are written to the history file.
zshaddhistory() {
    local line="${1%%$'\n'}"

    case "$line" in
        ' '*|'. '*|'source '*|'clear'|'exit'|'history'|'man '*|'ls'|'ll'|'la'|'pwd'|'bg'|'fg'|'jobs')
            return 1
            ;;
    esac

    if [[ "$line" == git\ * ]]; then
        local -a words
        words=(${=line})
        local second_word="${words[2]:-}"

        if [[ -n "$second_word" && "$second_word" != -* ]]; then
            if ! git --list-cmds=main,others | grep -Fqx "$second_word" 2>/dev/null \
                    && ! git config --get "alias.${second_word}" >/dev/null 2>&1; then
                return 1
            fi
        fi
    fi

    return 0
}

# Load shell-neutral interactive defaults.
if [[ -r "$HOME/.shellrc" ]]; then
    source "$HOME/.shellrc"
fi

# Add Homebrew's additional zsh functions before initializing completion.
if [[ -n "${HOMEBREW_PREFIX:-}" \
        && -d "$HOMEBREW_PREFIX/share/zsh-completions" ]]; then
    typeset -U fpath
    fpath=("$HOMEBREW_PREFIX/share/zsh-completions" "${fpath[@]}")
fi

# Enable zsh's native completion system. It handles SSH hosts from ~/.ssh/config
# through the standard _ssh helper.
autoload -Uz compinit
compinit -d "${ZDOTDIR:-$HOME}/.zcompdump"

# Match Readline's case-insensitive, first-Tab-visible completion behavior.
setopt AUTO_LIST
setopt COMPLETE_IN_WORD
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' squeeze-slashes true

# Match Readline's prefix history search on the Up and Down arrow keys.
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Initialize cross-shell tools using their zsh integrations.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi
if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --zsh 2>/dev/null)"
fi

# Load lightweight zsh plugins directly, without a framework or plugin manager.
zsh_autosuggestions_script=''
if [[ -n "${HOMEBREW_PREFIX:-}" \
        && -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    zsh_autosuggestions_script="$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    zsh_autosuggestions_script=/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -n "$zsh_autosuggestions_script" ]]; then
    source "$zsh_autosuggestions_script"
fi
unset zsh_autosuggestions_script

# Syntax highlighting should be the final plugin loaded so it can wrap widgets
# created by completion, fzf, and autosuggestions.
zsh_syntax_highlighting_script=''
if [[ -n "${HOMEBREW_PREFIX:-}" \
        && -r "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    zsh_syntax_highlighting_script="$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    zsh_syntax_highlighting_script=/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
if [[ -n "$zsh_syntax_highlighting_script" ]]; then
    source "$zsh_syntax_highlighting_script"
fi
unset zsh_syntax_highlighting_script

# Load local overrides (secrets and machine-specific paths) last.
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
