# .profile

# Add dedicated directory for local binaries to PATH.
export PATH="$HOME/.local/bin${PATH:+:$PATH}"

# Set the default editor.
if command -v nvim > /dev/null; then
    export EDITOR=nvim
    export VISUAL=nvim
elif command -v vim > /dev/null; then
    export EDITOR=vim
    export VISUAL=vim
fi

# Set the ripgrep configuration file path.
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
