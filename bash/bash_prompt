# bash_prompt

# Define a fallback wrapper for timeout on macOS if gtimeout is available.
if [[ "$(uname)" == "Darwin" ]] && ! command -v timeout >/dev/null && command -v gtimeout >/dev/null; then
    timeout() { gtimeout "$@"; }
fi

# Set color variables using tput.
reset="\[$(tput sgr0)\]"
red="\[$(tput setaf 1)\]"
green="\[$(tput setaf 2)\]"
yellow="\[$(tput setaf 3)\]"
blue="\[$(tput setaf 4)\]"
magenta="\[$(tput setaf 5)\]"
cyan="\[$(tput setaf 6)\]"
white="\[$(tput setaf 7)\]"

# Set components for the custom prompt (PS1).
username="$red\u$reset"
hostname="$blue\h$reset"
directory="$green\w$reset"
status="$magenta\$(git-status)$reset"

# Define helper functions for the prompt (PS1).
git-status() {
    local branch
    branch="$(GIT_OPTIONAL_LOCKS=0 git symbolic-ref --quiet --short HEAD 2>/dev/null \
           || GIT_OPTIONAL_LOCKS=0 git rev-parse --short HEAD 2>/dev/null)" || return

    local symbol=""

    if command -v timeout > /dev/null; then
        local check
        check="$(GIT_OPTIONAL_LOCKS=0 timeout 0.2 git status --porcelain 2>/dev/null)"
        if [ $? -eq 124 ]; then
            printf "${branch}  "
            return
        fi

        while IFS= read -r line; do
            case "$line" in
                \?\?*) [[ "$symbol" != *\?* ]] && symbol="${symbol}?" ;;
                \ [MADRCU]*) [[ "$symbol" != *\!* ]] && symbol="${symbol}!" ;;
                [MADRCU]*) [[ "$symbol" != *+* ]] && symbol="${symbol}+" ;;
            esac
        done <<< "$check"
    else
        if [ -n "$(GIT_OPTIONAL_LOCKS=0 git ls-files --others --exclude-standard 2>/dev/null)" ]; then
            symbol="${symbol}?"
        fi
        if ! GIT_OPTIONAL_LOCKS=0 git diff-files --quiet --ignore-submodules 2>/dev/null; then
            symbol="${symbol}!"
        fi
        if ! GIT_OPTIONAL_LOCKS=0 git diff --quiet --ignore-submodules --cached 2>/dev/null; then
            symbol="${symbol}+"
        fi
    fi

    if [ -n "${symbol}" ]; then
        symbol="[${symbol}]"
    fi

    printf "${branch}  ${symbol}"
}

# Set the prompt (PS1).
if command -v git > /dev/null; then
    export PS1="\n${username}@${hostname}: ${directory} ${status}\n\$ $reset"
else
    export PS1="\n${username}@${hostname}: ${directory}\n\$ $reset"
fi
