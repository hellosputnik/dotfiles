# .bash_profile

# Reuse the portable environment setup for login shells. The guard keeps
# .bashrc from sourcing it twice when both startup files are processed.
if [[ -z "${DOTFILES_COMMON_PROFILE_LOADED:-}" ]]; then
    source "$HOME/.profile"
    export DOTFILES_COMMON_PROFILE_LOADED=1
fi

# Source interactive non-login shell configurations.
source "$HOME/.bashrc"
