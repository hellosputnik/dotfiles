# .bashrc

# Reuse the portable environment setup for shells started without -l.
if [[ -z "${DOTFILES_COMMON_PROFILE_LOADED:-}" ]]; then
    source "$HOME/.profile"
    export DOTFILES_COMMON_PROFILE_LOADED=1
fi

# Set the custom Bash prompt.
source "$HOME/.bash_prompt"

# Append each command to the history file without rewriting existing entries.
# Assign a fresh value so child shells do not inherit the retired history hook
# from an already-running shell.
PROMPT_COMMAND='history -a'

# Ignore source, clear, exit, history, man, navigation, and job commands.
export HISTIGNORE=". *:source *:clear:exit:history:man *:ls:ll:la:pwd:bg:fg:jobs"

# Ignore duplicate commands and lines starting with spaces, and erase duplicates from history.
export HISTCONTROL=ignoreboth:erasedups

# Use a custom name for the history file to avoid unintended truncation.
export HISTFILE="${HOME}/.bash_history.${USER}"

# Increase the history size to leverage disk and RAM.
export HISTSIZE=100000
export HISTFILESIZE=$((HISTSIZE * 2))

# Add a timestamp to the history entries (ISO 8601).
export HISTTIMEFORMAT="%Y-%m-%dT%T%z "

# Enable spelling correction for cd (e.g., cd /etc/mall corrects to cd /etc/mail).
shopt -s cdspell

# Correct directory spelling errors during tab completion.
shopt -s dirspell 2>/dev/null

# Enable recursive globbing.
shopt -s globstar

# Enable case-insensitive globbing.
shopt -s nocaseglob

# Save multiline commands as a single history entry.
shopt -s cmdhist

# Append to history instead of overwriting it.
shopt -s histappend

# Update the LINES and COLUMNS variables after each command.
shopt -s checkwinsize

# Re-check that a hashed command still exists before running it. Bash caches the PATH entry it
# resolved per command, so an entry that is deleted rather than re-pointed (a symlink into a
# version-pinned directory) makes a running shell fail with "No such file or directory" while
# 'which' still succeeds. Recover a live shell with 'hash -r'.
shopt -s checkhash

# Prevent accidental file overwriting when redirecting output (use >| to force).
set -o noclobber

# Load shell-neutral interactive defaults.
if [[ -r "$HOME/.shellrc" ]]; then
    source "$HOME/.shellrc"
fi

# Initialize cross-shell tools using their Bash integrations.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# Load the host's Bash completions.
if [[ -n "${HOMEBREW_PREFIX:-}" &&
    -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
    # Homebrew's compatibility directory contains completions written for
    # bash-completion 1.x.
    export BASH_COMPLETION_COMPAT_DIR="$HOMEBREW_PREFIX/etc/bash_completion.d"
    source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
elif [[ -r /etc/bash_completion ]]; then
    source /etc/bash_completion
fi

# Complete SSH hostnames declared in ~/.ssh/config, ignoring wildcards.
if [[ -r "$HOME/.ssh/config" ]]; then
    if command -v rg >/dev/null 2>&1; then
        complete -o default -o nospace \
            -W "$(rg -i '^\s*Host\s+([^*?\s]+)' -o -r '$1' "$HOME/.ssh/config" 2>/dev/null)" \
            ssh scp sftp
    else
        complete -o default -o nospace \
            -W "$(awk '/^Host / { for (i = 2; i <= NF; i++) if ($i !~ /[*?]/) print $i }' "$HOME/.ssh/config" 2>/dev/null)" \
            ssh scp sftp
    fi
fi

# Initialize fzf after the base completion system so its key bindings and
# completion trigger can extend it.
if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash 2>/dev/null)"
fi

# Load local overrides (secrets and machine-specific paths) last.
if [[ -f "$HOME/.bashrc.local" ]]; then
    source "$HOME/.bashrc.local"
fi
