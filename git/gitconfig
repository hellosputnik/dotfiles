[core]
	excludesFile = ~/.gitignore

[init]
	defaultBranch = main

[alias]
	amend = commit --amend
	ls = log --abbrev-commit --all --decorate --graph --pretty
	# prune deletes outdated/unused remote-tracking branches.
	prune = fetch -p
	# tidy fetches & prunes, then deletes local branches already merged into the current branch (excluding main/master and the current one).
	tidy = "!git fetch --prune && git branch --merged | grep -Ev '\\*|master|main' | xargs -I {} git branch -d {}"
	# undo unwinds the last commit while keeping the changes staged.
	undo = reset --soft HEAD^

[help]
	autocorrect = 1

[log]
	# Display commit dates in the local time zone.
	date = local

[status]
	# Show every untracked file individually instead of collapsing untracked directories.
	showUntrackedFiles = all

[diff]
	tool = vimdiff

[difftool]
	# Skip the "launch <tool>?" confirmation when running git difftool.
	prompt = false

[pull]
	# Rebase on pull to keep history linear (avoids merge commits from upstream).
	rebase = true

[push]
	# Only push the current branch to its upstream counterpart.
	default = current
	# Safer than --force: refuses to overwrite the remote if it has commits we haven't seen.
	forceWithLease = true

[include]
	# Load machine-specific overrides (identity, work email, etc.) from a file
	# kept outside the dotfiles repo. Placed last so its values win.
	path = ~/.gitconfig.local
