[core]
	excludesFile = ~/.gitignore
	pager = less -FRX

[init]
	defaultBranch = main

[alias]
	amend = commit --amend
	ls = log --abbrev-commit --all --decorate --graph --pretty
	# The tidy alias fetches and prunes, then deletes local branches already merged into the current branch (excluding main, master, or the current branch).
	tidy = "!git fetch --prune && git branch --merged | grep -Ev '\\*|master|main' | xargs -r git branch -d"
	# The undo alias reverts the last commit while keeping the changes staged.
	undo = reset --soft HEAD^

[help]
	autocorrect = 1

[log]
	# Display commit dates in the local time zone.
	date = local

[status]
	# Show every untracked file individually instead of collapsing untracked directories.
	showUntrackedFiles = all

[diff]
	tool = vimdiff
	algorithm = histogram
	colorMoved = zebra
	renames = copies

[difftool]
	# Skip the "launch <tool>?" confirmation when running git difftool.
	prompt = false

[commit]
	verbose = true

[fetch]
	prune = true

[rerere]
	enabled = true
	autoupdate = true

[rebase]
	autosquash = true

[pull]
	# Rebase on pull to keep history linear (avoiding merge commits from upstream).
	rebase = true

[push]
	# Only push the current branch to its upstream counterpart.
	default = current
	# Safer than --force: refuses to overwrite the remote if it has unseen commits.
	forceWithLease = true

[include]
	# Load machine-specific overrides (identity, work email, etc.) from a file
	# kept outside the dotfiles repository. Placed last so its values override defaults.
	path = ~/.gitconfig.local
